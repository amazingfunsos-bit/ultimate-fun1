{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public user profile without PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 300000
        },
        "role": {
          "type": "string",
          "enum": ["member", "owner", "head_admin"]
        },
        "bannedUntil": {
          "type": "string",
          "maxLength": 40
        },
        "banReason": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "role", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user PII isolated from public reads",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Trusted admin/owner role grant document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["owner", "head_admin"]
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "grantedBy", "createdAt"]
    },
    "Joke": {
      "title": "Joke",
      "description": "Community joke item",
      "type": "object",
      "properties": {
        "setup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "punch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["setup", "punch", "authorId", "authorName", "createdAt"]
    },
    "Riddle": {
      "title": "Riddle",
      "description": "Brain-teaser riddle item",
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "a": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["q", "a", "authorId", "authorName", "createdAt"]
    },
    "Fact": {
      "title": "Fact",
      "description": "Interesting fun fact",
      "type": "object",
      "properties": {
        "txt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["txt", "authorId", "authorName", "createdAt"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "Fun challenge for members",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "desc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard", "epic"]
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "desc", "difficulty", "icon", "authorId", "createdAt"]
    },
    "AcceptedChallenge": {
      "title": "AcceptedChallenge",
      "description": "Record of a user accepting a challenge",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "challengeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "challengeId", "acceptedAt"]
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Meme, GIF, or Pixel Art item",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 850000
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": ["meme", "gif", "piskel"]
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["url", "caption", "type", "authorId", "createdAt"]
    },
    "GameItem": {
      "title": "GameItem",
      "description": "Owner-published HTML5 mini-game",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "desc": {
          "type": "string",
          "maxLength": 300
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500000
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "icon", "code", "authorId", "createdAt"]
    },
    "ScheduleBlock": {
      "title": "ScheduleBlock",
      "description": "Class-time lockdown schedule block",
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "start": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "tz": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "days": {
          "type": "array",
          "description": "Weekdays 0-6"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["label", "start", "end", "tz", "days", "authorId", "createdAt"]
    },
    "PendingItem": {
      "title": "PendingItem",
      "description": "Content item awaiting Head Admin approval",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "enum": ["jokes", "riddles", "facts", "challenges", "media", "games"]
        },
        "payload": {
          "type": "object"
        },
        "adderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "adderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["token", "itemType", "payload", "adderId", "adderName", "status", "createdAt", "updatedAt"]
    },
    "ChatThread": {
      "title": "ChatThread",
      "description": "Private support chat thread between a user and owners",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 500
        },
        "unreadForOwner": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "username", "lastMessage", "unreadForOwner", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message inside a private chat thread",
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "enum": ["user", "owner"]
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["from", "senderUid", "senderName", "text", "createdAt"]
    },
    "FeedbackItem": {
      "title": "FeedbackItem",
      "description": "User rating and feedback submission",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "rating": {
          "type": "integer"
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "rating", "text", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit log of owner actions",
      "type": "object",
      "properties": {
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "role": {
          "type": "string",
          "maxLength": 20
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "detail": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["actorUid", "username", "role", "action", "detail", "createdAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Pinned site-wide announcement",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "byUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "byName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["text", "byUid", "byName", "createdAt"]
    },
    "Broadcast": {
      "title": "Broadcast",
      "description": "Live broadcast notification",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "byUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "byName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["text", "byUid", "byName", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global site-wide theme configuration",
      "type": "object",
      "properties": {
        "siteTheme": {
          "type": "string",
          "enum": ["default", "sunset", "ice"]
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["siteTheme", "updatedBy", "updatedAt"]
    },
    "RecoverySecret": {
      "title": "RecoverySecret",
      "description": "Server-only hashed recovery code for password resets without email",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "codeHash": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "failedAttempts": {
          "type": "integer"
        },
        "lockedUntil": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "codeHash", "updatedAt"]
    }
  },
  "firestore": {
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public user profiles (username, avatar, role, ban status)"
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user PII (email)"
    },
    "/users_public/{userId}/acceptedChallenges/{challengeId}": {
      "schema": { "$ref": "#/entities/AcceptedChallenge" },
      "description": "Challenges accepted by a user"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Owner/Admin role grant records"
    },
    "/jokes/{jokeId}": {
      "schema": { "$ref": "#/entities/Joke" },
      "description": "Shared jokes collection"
    },
    "/riddles/{riddleId}": {
      "schema": { "$ref": "#/entities/Riddle" },
      "description": "Shared riddles collection"
    },
    "/facts/{factId}": {
      "schema": { "$ref": "#/entities/Fact" },
      "description": "Shared facts collection"
    },
    "/challenges/{challengeId}": {
      "schema": { "$ref": "#/entities/Challenge" },
      "description": "Shared challenges collection"
    },
    "/media/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaItem" },
      "description": "Shared memes, GIFs, and pixel art"
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/GameItem" },
      "description": "Owner-published custom HTML5 games"
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/ScheduleBlock" },
      "description": "Class-time lockdown schedule blocks"
    },
    "/pendingItems/{pendingId}": {
      "schema": { "$ref": "#/entities/PendingItem" },
      "description": "Content items pending Head Admin approval"
    },
    "/chatThreads/{threadId}": {
      "schema": { "$ref": "#/entities/ChatThread" },
      "description": "Private chat thread metadata per user"
    },
    "/chatThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a user's private chat thread"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/FeedbackItem" },
      "description": "User feedback and ratings"
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Owner action audit logs"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Pinned site-wide announcements"
    },
    "/broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/Broadcast" },
      "description": "Live broadcast toast alerts"
    },
    "/siteConfig/{configId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global site settings such as active theme"
    },
    "/recovery_secrets/{userId}": {
      "schema": { "$ref": "#/entities/RecoverySecret" },
      "description": "Server-only hashed recovery codes for password reset without email (denied to all clients in firestore.rules)"
    }
  }
}
